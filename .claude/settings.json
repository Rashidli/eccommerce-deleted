{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(DROP DATABASE*)",
      "Read(//var/www/ecommerce/.env*)"
    ]
  }
}
